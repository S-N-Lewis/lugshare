.page { min-height: 100vh; background: #F5F7FA; }
.loading { text-align: center; color: #9AA0A6; padding: 100rpx; }
.conv { display: flex; align-items: center; background: #fff; padding: 28rpx 24rpx; border-bottom: 2rpx solid #F1F3F4; }
.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: #E8F0FE; color: #1A73E8; display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 600; flex-shrink: 0; }
.conv-main { flex: 1; margin-left: 20rpx; min-width: 0; }
.conv-top { display: flex; align-items: center; justify-content: space-between; }
.conv-name { font-size: 30rpx; font-weight: 600; }
.conv-time { font-size: 22rpx; color: #9AA0A6; }
.conv-route { font-size: 23rpx; color: #1A73E8; margin-top: 6rpx; }
.conv-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.conv-last { font-size: 25rpx; color: #5F6368; flex: 1; }
.badge { background: #E53935; color: #fff; font-size: 20rpx; min-width: 34rpx; height: 34rpx; line-height: 34rpx; text-align: center; border-radius: 20rpx; padding: 0 8rpx; margin-left: 12rpx; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 140rpx 60rpx; color: #9AA0A6; font-size: 28rpx; }
.empty-icon { font-size: 88rpx; margin-bottom: 24rpx; }
.empty-sub { font-size: 23rpx; margin-top: 14rpx; text-align: center; line-height: 1.6; }
.empty-btn { margin-top: 36rpx; padding: 16rpx 56rpx; }
