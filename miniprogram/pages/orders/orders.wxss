.page { min-height: 100vh; background: #F5F7FA; }
.tabs { display: flex; background: #fff; padding: 0 24rpx; border-bottom: 2rpx solid #E8EAED; }
.tab { flex: 1; text-align: center; padding: 28rpx 0; font-size: 30rpx; color: #5F6368; position: relative; }
.tab.on { color: #1A73E8; font-weight: 600; }
.tab.on::after { content: ''; position: absolute; bottom: 0; left: 25%; right: 25%; height: 6rpx; background: #1A73E8; border-radius: 4rpx; }
.item { background: #fff; border-radius: 16rpx; padding: 28rpx; margin: 20rpx 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04); }
.item-route { font-size: 32rpx; font-weight: 600; max-width: 70%; }
.item-meta { font-size: 25rpx; color: #5F6368; margin-top: 16rpx; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; color: #9AA0A6; font-size: 28rpx; }
.empty-icon { font-size: 88rpx; margin-bottom: 24rpx; }
.empty-btn { margin-top: 32rpx; padding: 16rpx 56rpx; }
.greeting-line { margin-top: 16rpx; padding: 16rpx; background: #F8F9FA; border-radius: 8rpx; font-size: 23rpx; color: #5F6368; line-height: 1.6; }
.greeting-copy { color: #1A73E8; margin-left: 8rpx; }
