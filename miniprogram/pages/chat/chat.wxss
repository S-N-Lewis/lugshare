.page { display: flex; flex-direction: column; height: 100vh; background: #F5F7FA; }
.trip-banner { background: #FEF7E0; color: #B06000; font-size: 22rpx; padding: 16rpx 24rpx; text-align: center; }
.msg-list { flex: 1; overflow-y: auto; padding: 24rpx; }
.load-tip { text-align: center; font-size: 22rpx; color: #9AA0A6; padding: 16rpx; }
.msg-row { display: flex; align-items: flex-start; margin-bottom: 28rpx; }
.msg-row.mine { flex-direction: row-reverse; }
.msg-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #E8F0FE; color: #1A73E8; display: flex; align-items: center; justify-content: center; font-size: 28rpx; flex-shrink: 0; }
.msg-body { max-width: 75%; margin: 0 16rpx; }
.bubble { display: inline-block; background: #fff; padding: 20rpx 24rpx; border-radius: 4rpx 16rpx 16rpx 16rpx; font-size: 28rpx; line-height: 1.6; color: #202124; word-break: break-all; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.bubble-mine { background: #1A73E8; color: #fff; border-radius: 16rpx 4rpx 16rpx 16rpx; }
.bubble-failed { background: #FCEBEB; color: #A32D2D; }
.msg-time { display: block; font-size: 20rpx; color: #9AA0A6; margin-top: 8rpx; }
.msg-row.mine .msg-time { text-align: right; }
.msg-fail { font-size: 20rpx; color: #A32D2D; margin-top: 8rpx; }
.empty-chat { text-align: center; color: #9AA0A6; font-size: 25rpx; padding: 120rpx 40rpx; line-height: 1.6; }
.input-bar { display: flex; align-items: center; padding: 16rpx 24rpx; background: #fff; border-top: 2rpx solid #E8EAED; gap: 16rpx; }
.msg-input { flex: 1; background: #F1F3F4; border-radius: 40rpx; padding: 18rpx 28rpx; font-size: 28rpx; min-height: 76rpx; }
.send-btn { background: #1A73E8; color: #fff; font-size: 28rpx; padding: 18rpx 32rpx; border-radius: 40rpx; }
.send-disabled { background: #C9D7EE; }
