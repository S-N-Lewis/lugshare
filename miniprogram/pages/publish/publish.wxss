.page { min-height: 100vh; background: #F5F7FA; padding-top: 20rpx; }
.form-card { background: #fff; border-radius: 16rpx; margin: 20rpx 24rpx; padding: 28rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #202124; margin-bottom: 24rpx; }
.row { display: flex; gap: 20rpx; }
.col { flex: 1; min-width: 0; }
.field { margin-top: 24rpx; }
.label { display: block; font-size: 24rpx; color: #5F6368; margin-bottom: 12rpx; }
.input, .textarea {
  width: 100%; background: #F8F9FA; border-radius: 10rpx; padding: 20rpx;
  font-size: 28rpx; color: #202124; min-height: 80rpx;
}
.textarea { height: 160rpx; }
.picker { line-height: 40rpx; }
.ph { color: #9AA0A6; }
.hint { font-size: 22rpx; color: #9AA0A6; line-height: 1.6; margin-top: 12rpx; }
.chip-wrap { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip {
  font-size: 25rpx; padding: 12rpx 24rpx; border-radius: 40rpx;
  background: #F1F3F4; color: #5F6368; border: 2rpx solid transparent;
}
.chip-on { background: #E8F0FE; color: #1A73E8; border-color: #1A73E8; }
.chip-off { background: #FCEBEB; color: #A32D2D; border-color: transparent; }
.chip-rejected-on { background: #A32D2D; color: #fff; border-color: #A32D2D; }

.compliance { display: flex; align-items: flex-start; margin: 28rpx 24rpx; gap: 16rpx; }
.checkbox {
  width: 36rpx; height: 36rpx; flex-shrink: 0; border: 2rpx solid #C4C7C5;
  border-radius: 8rpx; display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 24rpx; margin-top: 2rpx;
}
.checkbox.checked { background: #1A73E8; border-color: #1A73E8; }
.compliance-text { font-size: 24rpx; color: #5F6368; line-height: 1.6; }
.submit-wrap { padding: 20rpx 24rpx 60rpx; }
