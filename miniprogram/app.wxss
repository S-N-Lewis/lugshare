/* app.wxss - 全局样式 */
page {
  --primary: #1A73E8;
  --primary-dark: #1557B0;
  --danger: #E53935;
  --warning: #F9A825;
  --success: #1E8E3E;
  --text: #202124;
  --text-2: #5F6368;
  --text-3: #9AA0A6;
  --line: #E8EAED;
  --bg: #F5F7FA;
  --card: #FFFFFF;
  --radius: 16rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background: var(--bg);
  box-sizing: border-box;
}

view, text, input, textarea, button, image {
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 主按钮 */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}
.btn-primary::after { border: none; }
.btn-primary.disabled { background: #C9D7EE; }

/* 幽灵按钮 */
.btn-ghost {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
  text-align: center;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: #E8F0FE;
  color: var(--primary);
}
.tag-warn { background: #FEF7E0; color: #B06000; }
.tag-success { background: #E6F4EA; color: var(--success); }
.tag-gray { background: #F1F3F4; color: var(--text-2); }

/* 安全区 */
.safe-bottom { padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); }

/* flex 工具 */
.flex { display: flex; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
