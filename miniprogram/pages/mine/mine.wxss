.page { min-height: 100vh; background: #F5F7FA; }
.user-card {
  background: linear-gradient(135deg, #1A73E8, #4A9AF5); color: #fff;
  padding: 60rpx 32rpx 48rpx; display: flex; align-items: center; gap: 24rpx;
}
.avatar {
  width: 110rpx; height: 110rpx; border-radius: 50%; background: rgba(255,255,255,.25);
  display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 600; flex-shrink: 0;
}
.u-info { flex: 1; min-width: 0; }
.u-name { font-size: 34rpx; font-weight: 600; }
.u-name-input { font-size: 32rpx; color: #fff; border-bottom: 2rpx solid rgba(255,255,255,.6); }
.u-tip { font-size: 24rpx; opacity: .9; margin-top: 10rpx; }
.u-save { font-size: 28rpx; padding: 12rpx 24rpx; background: #fff; color: #1A73E8; border-radius: 40rpx; }

.card { background: #fff; border-radius: 16rpx; margin: 20rpx 24rpx; padding: 8rpx 28rpx; }
.menu-item { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 2rpx solid #F1F3F4; }
.menu-item:last-child { border-bottom: none; }
.mi-icon { font-size: 40rpx; margin-right: 24rpx; }
.mi-text { flex: 1; font-size: 30rpx; }
.mi-arrow { font-size: 40rpx; color: #C4C7C5; }

.about { padding: 28rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.about-text { font-size: 26rpx; color: #5F6368; line-height: 1.8; margin-top: 16rpx; }

.mask { position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 100; display: flex; align-items: center; justify-content: center; padding: 40rpx; }
.modal { width: 100%; background: #fff; border-radius: 24rpx; padding: 40rpx 32rpx 32rpx; }
.modal-title { font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 28rpx; }
.modal-body { font-size: 27rpx; color: #5F6368; line-height: 1.8; margin-bottom: 20rpx; }
.modal-btn { margin-top: 12rpx; }
